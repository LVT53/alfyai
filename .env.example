# Core runtime
# Optional. Required only for trusted internal service assertions.
ALFYAI_API_SIGNING_KEY=
# REQUIRED in production. At least 32 characters of randomness:
#   SESSION_SECRET=$(openssl rand -hex 32)
# A server with NODE_ENV=production REFUSES TO START if this is missing, empty,
# shorter than 32 characters, or left at a placeholder like the one below.
# Outside production it falls back to a public development value and warns once.
#
# It is not only the session secret: it derives the encryption keys for stored
# connection secrets and provider API keys, so CHANGING it makes every stored
# credential undecryptable and they have to be re-entered.
SESSION_SECRET=change-me-to-a-random-long-secret
DATABASE_PATH=./data/chat.db
# adapter-node listen address for host-managed deployments
HOST=127.0.0.1
PORT=3001
# Behind a reverse proxy, tell adapter-node which header carries the real
# client address. Without these, getClientAddress() returns the proxy's
# loopback address for every request, and the login throttle's per-address
# budget is skipped (the per-email budget still applies). See
# docs/configuration.md, "Client addresses behind the proxy".
# Only set these when the proxy OVERWRITES the header and is the sole ingress —
# if the Node port is reachable directly, clients can forge it.
#ADDRESS_HEADER=x-forwarded-for
#XFF_DEPTH=1
# Content Security Policy: off | report-only | enforce. Default report-only —
# the policy is sent as Content-Security-Policy-Report-Only, so violations show
# up in the browser console without breaking anything. Flip to `enforce` after
# watching a staging console; see docs/security-headers.md. Any unrecognized
# value means report-only. Restart to apply; no rebuild needed.
CSP_MODE=report-only
REQUEST_TIMEOUT_MS=300000
MAX_MESSAGE_LENGTH=
ATTACHMENT_TRACE_DEBUG=false

# Optional Sentry error monitoring and performance tracing.
# The app does not send events unless a DSN is configured.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACE_PROPAGATION_TARGETS=localhost,/api/
PUBLIC_SENTRY_TRACE_PROPAGATION_TARGETS=localhost,/api/
PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1
# Optional build-time source map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# Default model ID assigned to new users. Must match an available model name or provider ID.
# Can also be overridden in Settings > Administration > System.
DEFAULT_NEW_USER_MODEL=model1

# Optional model ID for Automatic Reasoning Depth classification.
# Leave empty to use the user's selected chat model.
# Can also be overridden in Settings > Administration > System.
REASONING_DEPTH_CLASSIFIER_MODEL=

# Primary model endpoint
MODEL_1_BASEURL=http://localhost:30001/v1
MODEL_1_API_KEY=
MODEL_1_NAME=nemotron-nano
MODEL_1_DISPLAY_NAME=Nemotron Nano
MODEL_1_SYSTEM_PROMPT=
# Optional max output tokens passed to the primary model provider
MODEL_1_MAX_TOKENS=
MODEL_1_REASONING_EFFORT=
MODEL_1_THINKING_TYPE=

# Secondary model endpoint
MODEL_2_BASEURL=http://localhost:30002/v1
MODEL_2_API_KEY=
MODEL_2_NAME=translategemma
MODEL_2_DISPLAY_NAME=TranslateGemma
MODEL_2_SYSTEM_PROMPT=
# Optional max output tokens passed to the secondary model provider
MODEL_2_MAX_TOKENS=
MODEL_2_REASONING_EFFORT=
MODEL_2_THINKING_TYPE=
MODEL_2_ENABLED=true

# Title generation
TITLE_GEN_URL=http://localhost:30001/v1
TITLE_GEN_API_KEY=
TITLE_GEN_MODEL=nemotron-nano
TITLE_GEN_SYSTEM_PROMPT_EN=
TITLE_GEN_SYSTEM_PROMPT_HU=
TITLE_GEN_SYSTEM_PROMPT_CODE_APPENDIX_EN=
TITLE_GEN_SYSTEM_PROMPT_CODE_APPENDIX_HU=

# Optional dedicated context summarizer
# If left empty, the app falls back to TITLE_GEN_URL / TITLE_GEN_API_KEY.
CONTEXT_SUMMARIZER_URL=
CONTEXT_SUMMARIZER_API_KEY=
CONTEXT_SUMMARIZER_MODEL=

# Optional Hugging Face Text Embeddings Inference clients
# Typical models: bge-m3 (embedder) and bge-reranker-v2-m3 (reranker)
TEI_EMBEDDER_URL=
TEI_EMBEDDER_API_KEY=
TEI_EMBEDDER_MODEL=
# Inputs per /embed request. Must not exceed the server's --max-client-batch-size
# (8 on the default TEI setup); larger values are chunked and the server's
# limit is learned from its 422 if the value is still too high.
TEI_EMBEDDER_BATCH_SIZE=8
TEI_RERANKER_URL=
TEI_RERANKER_API_KEY=
TEI_RERANKER_MODEL=
TEI_RERANKER_MAX_TEXTS=32
TEI_TIMEOUT_MS=120000

# Local judge-gated memory pipeline
# Model that judges post-turn candidate memories. model1, model2, or provider:<providerId>:<modelId>.
MEMORY_JUDGE_MODEL=model1
# Model that runs the nightly memory consolidation/persona-summary pass.
MEMORY_CONSOLIDATION_MODEL=model1
# Idle minutes after the last turn before the deferred memory judge runs for a user.
MEMORY_JUDGE_IDLE_MINUTES=30
# Minutes between nightly memory consolidation sweeps (0 disables the scheduler).
MEMORY_CONSOLIDATION_INTERVAL_MINUTES=1440
# When true, the judge logs decisions without writing memory profile changes.
MEMORY_JUDGE_DRY_RUN=false
# Minutes between per-user memory maintenance sweeps, e.g. embedding backfill (0 disables the scheduler).
MEMORY_MAINTENANCE_INTERVAL_MINUTES=0

# MinerU Document Extraction
# MinerU is a state-of-the-art document parsing engine running as a Docker service.
# It handles PDF, DOCX, PPTX, XLSX, images, and web pages with 109-language OCR.
# See docs/uploads.md for how to run the service.
MINERU_API_URL=http://127.0.0.1:8001
# Bearer token. Empty means anonymous access, which a local server allows.
# MINERU_API_KEY=
# auto | flash | basic | standard | advanced. "auto" sends no tier at all and
# lets the server's own start-up tier decide; naming a tier the server does not
# offer fails the extraction rather than quietly downgrading it.
# MINERU_DEFAULT_TIER=auto
# auto | txt | ocr. "auto" lets MinerU decide per file.
# MINERU_OCR_MODE=auto
# Whole-document deadline, upload through result (10000-3600000). Replaces
# MINERU_TIMEOUT_MS, which is still read as a fallback for one release.
# MINERU_JOB_TIMEOUT_MS=300000
# First wait before checking whether a parse has finished (250-60000).
# MINERU_POLL_MIN_MS=2000
# Where the growing wait between status checks stops (1000-300000).
# MINERU_POLL_MAX_MS=30000
# Timeout for one quick call such as a status check (1000-300000).
# MINERU_REQUEST_TIMEOUT_MS=30000
# Timeout for sending a document or downloading its result (10000-3600000).
# MINERU_TRANSFER_TIMEOUT_MS=600000
# How long MinerU's version, tiers and formats are reused (0-3600000; 0 always
# re-reads).
# MINERU_CAPABILITIES_TTL_MS=300000
# Disk budget for one document's parse bundle (1048576-536870912 = 1 MiB-512 MiB).
# Text and structure are always kept; figures are dropped once it is reached.
# MINERU_BUNDLE_MAX_BYTES=33554432
# Cut long documents on block boundaries so a table is never split, and record
# which pages each chunk covers. false falls back to character chunking.
# MINERU_STRUCTURE_CHUNKING_ENABLED=true

# Document extraction ledger
# Uploads no longer block on extraction: every document becomes a durable job
# that a background worker claims, retries with backoff, and can resume after a
# restart. All eleven keys are editable live on Settings → System → Advanced.
# Set to false to pause the worker; queued documents wait rather than fail.
DOCUMENT_EXTRACTION_WORKER_ENABLED=true
# Documents extracted at once, across everyone (1-16).
DOCUMENT_EXTRACTION_MAX_CONCURRENCY=3
# Of those, how many one person may hold (1-16).
DOCUMENT_EXTRACTION_PER_USER_CONCURRENCY=2
# Automatic attempts before a document is reported as failed (1-10).
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
# Backoff before the second attempt; it triples each time, jittered ±20%.
DOCUMENT_EXTRACTION_RETRY_BASE_MS=2000
# Ceiling the growing backoff stops at.
DOCUMENT_EXTRACTION_RETRY_MAX_MS=60000
# Heartbeat silence after which an attempt is reclaimed. Must stay above
# MINERU_JOB_TIMEOUT_MS or a live extraction would be torn out mid-call; the
# code enforces max(this, MINERU_JOB_TIMEOUT_MS * 2).
DOCUMENT_EXTRACTION_STALE_ATTEMPT_MS=900000
# How often a working attempt marks itself alive.
DOCUMENT_EXTRACTION_HEARTBEAT_MS=15000
# How long an upload request waits inline for a plain-text file (0 = never).
DOCUMENT_EXTRACTION_INLINE_BUDGET_MS=1500
# How long Send waits for an attachment that is nearly ready (0 = never).
DOCUMENT_EXTRACTION_PREFLIGHT_WAIT_MS=2500
# Largest file read straight in as text without a parser (8 MiB).
DOCUMENT_EXTRACTION_MAX_DIRECT_TEXT_BYTES=8388608

# Web research and image search
# Parallel powers web search and page extraction (research_web, fetch_url,
# Atlas). Brave powers image search.
PARALLEL_API_KEY=
# Override the Parallel API host (defaults to https://api.parallel.ai). Mainly
# for tests / self-hosted proxies; leave empty in production.
PARALLEL_BASE_URL=
BRAVE_SEARCH_API_KEY=
# Max chars of research_web's answer-brief markdown sent to the model (default
# 12000 when unset/invalid). fetch_url sizes its own brief to the model's
# context window instead and ignores this knob.
WEB_RESEARCH_BRIEF_MAX_CHARS=12000

# Routing (map_route tool). ORS_BASE_URL is the self-hosted OpenRouteService
# v2 API base INCLUDING the path prefix (e.g. http://127.0.0.1:8088/ors).
# Empty => the map_route tool is not registered at all.
ORS_BASE_URL=
# Optional Nominatim `/search` base for resolving place names to coordinates
# (e.g. http://127.0.0.1:8081). Empty => the model must pass explicit lat/lng.
GEOCODER_BASE_URL=
# Optional human-readable region the loaded ORS graph covers (e.g. Hungary).
# Shown to the model so it does not route outside the map extract and can
# explain an out-of-coverage miss instead of calling routing "unavailable".
ORS_COVERAGE_LABEL=

# Inline map card tile proxy (GET /api/map-tiles/[z]/[x]/[y]). There is no
# self-hosted tile server today, so this proxies+caches OSM's standard raster
# tiles; point this at a self-hosted tile server later by changing only this
# URL. Tiles are cached on disk (MAP_TILES_DIR, 2GB/30-day cap) — see OSM's
# tile usage policy (no bulk prefetch, visible attribution, identifying UA).
MAP_TILE_UPSTREAM_BASE_URL=https://tile.openstreetmap.org
# Contact (email or URL) appended to the proxy's User-Agent, per OSM's usage
# policy. Empty => the header identifies only the app name.
MAP_TILE_CONTACT=
MAP_TILES_DIR=./data/map-tiles

# On-demand routing coverage. When enabled, a point outside every loaded
# region triggers a download of the matching Geofabrik extract and a graph
# build in a dedicated OpenRouteService container (via Docker; set DOCKER_HOST
# to a docker-socket-proxy so the app user needs no docker group). The fixed
# ORS_BASE_URL instance stays registered as the legacy region
# (ROUTING_LEGACY_REGION_ID, a Geofabrik id such as "hungary").
ROUTING_ON_DEMAND_ENABLED=false
ROUTING_REGIONS_DIR=./data/routing-regions
ROUTING_ORS_IMAGE=openrouteservice/openrouteservice:latest
ROUTING_REGION_XMX=12g
ROUTING_REGION_PORT_RANGE=8300-8399
ROUTING_REGION_HOST_IP=127.0.0.1
ROUTING_REGION_IDLE_MINUTES=180
ROUTING_REGION_MAX_PBF_MB=2500
# Name of a running Nominatim container to `nominatim add-data` each new
# region into (its /regions mount must be ROUTING_REGIONS_DIR). Empty = off.
ROUTING_GEOCODER_IMPORT_CONTAINER=
ROUTING_LEGACY_REGION_ID=hungary
# Extract mirrors tried, in order, when download.geofabrik.de cannot serve the
# .osm.pbf (its index stays up while the extracts 502 — that happened for days
# in September 2026). Comma-separated base URLs; the region name is remapped
# for each mirror (hyphens become underscores, plus a small alias table, e.g.
# ireland-and-northern-ireland -> ireland). Geofabrik publishes .md5 files and
# is verified against them; mirrors do not, so their Content-Length must match
# exactly. Empty disables the fallback.
ROUTING_EXTRACT_MIRRORS=https://download.openstreetmap.fr/extracts
# Geofabrik ids that must always be available: downloaded and built on start
# (retried with backoff until they succeed) and never stopped by the idle
# sweep. Comma-separated, e.g. "ireland-and-northern-ireland,netherlands".
ROUTING_RESIDENT_REGION_IDS=
# Public transport timetables (map_route's `transit` / `timetable` actions).
# LEAVE THIS EMPTY (or set it to "catalogue") to use the shipped feed
# catalogue in src/lib/server/services/routing/gtfs-catalogue.ts, which is
# national for the three regions it covers:
#   hungary                        21 feeds — MÁV/GYSEV rail, Volánbusz
#                                  coaches, BKK Budapest and the city
#                                  operators (Hungary publishes no single
#                                  national feed, so this bundle IS one)
#   ireland-and-northern-ireland   the NTA's combined 104-agency feed
#                                  (Republic only — Translink publishes none)
#   netherlands                    OVapi's national feed, incl. NS rail
# To take control, list regions explicitly: `|` separates the feeds of ONE
# region, `,` separates regions. A region you do NOT name then gets no
# timetables; `regionId=catalogue` opts one region back into the catalogue.
#   ROUTING_GTFS_FEEDS=hungary=catalogue,austria=https://a.test/a.zip|https://a.test/b.zip
# A region with feeds gets a `public-transport` profile whose gtfs_file is the
# comma-joined list of the feeds that downloaded (GraphHopper loads each as its
# own feed). The first build and every refresh take the container down for the
# length of the build, so it only ever starts in the nightly window.
ROUTING_GTFS_FEEDS=
# Feeds dropped from whatever the line above resolves to, as regionId:feedId
# pairs (`regionId:*` drops a whole region). LICENCE NOTE: the Hungarian rail
# feed `mav-gysev` is MÁV's own data relayed by menetbrand.com, and MÁV asks
# GTFS users to file its (free) request form — set
# ROUTING_GTFS_FEED_EXCLUDE=hungary:mav-gysev if you have not done that. Rail
# then drops out of Hungarian journeys; coaches and city networks stay.
ROUTING_GTFS_FEED_EXCLUDE=
# Default staleness before a feed is re-downloaded and its public-transport
# graph rebuilt. A catalogue feed's own cadence wins over this (BKK daily, the
# small city feeds fortnightly). The rebuild is only ever STARTED between
# 03:00 and 05:00 local time, because it restarts the region's container;
# unchanged feeds cost a 304, not a transfer.
ROUTING_GTFS_REFRESH_DAYS=7
# Hard cap on a single GTFS download (MB). The national Dutch feed is ~250 MB.
ROUTING_GTFS_MAX_MB=600
# Docker endpoint used by the file-production sandbox and region manager.
# Point it at a filtered docker-socket-proxy (see deploy/alfyai-docker-proxy.service).
DOCKER_HOST=

# Conversation history is sent to the model as native chat turns (user /
# assistant / tool messages) so the prefix is cacheable and the model sees its
# own prior tool use. Set to false to fall back to the flattened text block.
NATIVE_HISTORY_ENABLED=true
# Log outbound message shape (roles, part types, token estimates; never
# content) for each model call. Verification aid only.
NORMAL_CHAT_DEBUG_OUTBOUND=0

# Google OAuth (Calendar/Contacts connect flow). Register an OAuth 2.0 web
# app in Google Cloud Console with an authorized redirect URI of
# {your origin}/api/oauth/google/callback. Leave both empty to keep the
# Google connect flow disabled ("not configured").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Atlas (deep-research reports) — ADR 0062 and ADR 0063.
# Which Atlas CONTENT pipeline a new job runs on. v1 is the original pipeline;
# v2 is the rebuild on the harness's research_web path, with inline citations,
# per-claim verification and confidence; v3 reasons from an evidence bank —
# structured claims, an answer table before any prose, one writer with the
# whole report in view, and a critic that may order targeted re-search. Only
# the exact value "v2" or "v3" selects one, and the version is stamped on the
# job row at kickoff, so flipping this never re-routes a queued job or splits a
# Continue/Revise/Fork family.
# Also settable from admin config as ATLAS_PIPELINE.
ATLAS_PIPELINE=v1
# Age past which a cited statistic is listed in the report's Limitations
# section (months). v2 only.
ATLAS_STALE_MONTHS=18
# Per-profile research questions and bounded research rounds for v2. Defaults
# shown; raise the counts for broader coverage at proportionally more tokens
# and wall time.
# ATLAS_V2_QUESTIONS_OVERVIEW=6
# ATLAS_V2_QUESTIONS_IN_DEPTH=10
# ATLAS_V2_QUESTIONS_EXHAUSTIVE=16
# ATLAS_V2_ROUNDS_OVERVIEW=1
# ATLAS_V2_ROUNDS_IN_DEPTH=2
# ATLAS_V2_ROUNDS_EXHAUSTIVE=3
# Hard word ceiling per profile for a v2 report, summary and Limitations
# included. The writer is given a matching per-section sentence cap, and a
# deterministic post-cap drops trailing sentences (uncited ones first) if the
# model overshoots anyway.
# ATLAS_V2_MAX_WORDS_OVERVIEW=1100
# ATLAS_V2_MAX_WORDS_IN_DEPTH=2800
# ATLAS_V2_MAX_WORDS_EXHAUSTIVE=5500
# Cap on indexed sources carried into the write phase, per profile. Sources
# beyond the cap are dropped round-robin-fairly across research questions, so
# every question keeps representation.
# ATLAS_V2_MAX_SOURCES_OVERVIEW=20
# ATLAS_V2_MAX_SOURCES_IN_DEPTH=40
# ATLAS_V2_MAX_SOURCES_EXHAUSTIVE=80
# Claims per batched entailment call on the control model (1 disables
# batching), and how many sections are written in parallel.
# ATLAS_V2_ENTAILMENT_BATCH=10
# ATLAS_V2_WRITER_CONCURRENCY=5

# --- Atlas v3 (ADR 0063) ---------------------------------------------------
# One model per Atlas v3 task. Each accepts "model1", "model2" or
# "provider:<providerId>:<modelId>". LEAVE UNSET to inherit: the researcher and
# writer fall back to ATLAS_SYNTHESIS_MODEL, and the ask, outline, critic and
# verifier to ATLAS_AUDIT_MODEL. Clearing the value in admin config restores
# the inherited model rather than pinning model1.
# ATLAS_V3_ASK_MODEL=
# ATLAS_V3_RESEARCHER_MODEL=
# ATLAS_V3_OUTLINE_MODEL=
# ATLAS_V3_WRITER_MODEL=
# ATLAS_V3_CRITIC_MODEL=
# ATLAS_V3_VERIFIER_MODEL=
# Whole-report critic rounds. Each round may order rewrites, cuts, and a small
# targeted research budget for the claims it cannot support. 0 disables the
# critic; the ceiling is 3 whatever this says.
# ATLAS_V3_CRITIC_ROUNDS=2
# Isolated researcher calls in flight at once. Each owns one sub-question in a
# context nothing else sees.
# ATLAS_V3_RESEARCHER_CONCURRENCY=3
# Searches one researcher step issues at once. Clamped to 3-5: fewer wastes the
# fan-out, more buys noise.
# ATLAS_V3_SEARCHES_PER_STEP=3
# Pages read per sub-question, spent best-tier-first. Page reads are the
# marginal cost and the marginal latency of a v3 run.
# ATLAS_V3_PAGES_PER_QUESTION_OVERVIEW=2
# ATLAS_V3_PAGES_PER_QUESTION_IN_DEPTH=3
# ATLAS_V3_PAGES_PER_QUESTION_EXHAUSTIVE=4
# The Hungarian language standard: register rules for the writer, register
# checks for the critic, and KSH / Magyar Közlöny / njt.hu / MNB promoted to
# primary sources. Set to false to write Hungarian without it.
# ATLAS_V3_LANGUAGE_STANDARD_HU=true

# Optional: Context token limits.
# Target and compaction defaults derive from the configured context window.
# MAX_MODEL_CONTEXT=262144
# COMPACTION_UI_THRESHOLD=209715 # defaults to floor(MAX_MODEL_CONTEXT * 0.8)
# TARGET_CONSTRUCTED_CONTEXT=235929 # defaults to floor(MAX_MODEL_CONTEXT * 0.9)
# MODEL_1_MAX_MODEL_CONTEXT=262144
# MODEL_1_COMPACTION_UI_THRESHOLD=209715
# MODEL_1_TARGET_CONSTRUCTED_CONTEXT=235929
# MODEL_2_MAX_MODEL_CONTEXT=262144
# MODEL_2_COMPACTION_UI_THRESHOLD=209715
# MODEL_2_TARGET_CONSTRUCTED_CONTEXT=235929

# Optional: Concurrent request limits (defaults: 3 global, 1 per-user)
# Limits how many simultaneous chat requests the server accepts
# CONCURRENT_STREAM_LIMIT=3
# PER_USER_STREAM_LIMIT=1

# Optional: Max file upload size in bytes (default: 104857600 = 100MB)
# MAX_FILE_UPLOAD_SIZE=104857600
