# Copy to native-model.env; never commit provider credentials.
# These models must agree. Use the operator-verified local model ID.
HINDSIGHT_API_LLM_MODEL=your-local-model
HINDSIGHT_API_HTTP_UPSTREAM_MODEL=your-local-model
HINDSIGHT_API_HTTP_UPSTREAM_URL=http://host.docker.internal:8000/v1
HINDSIGHT_API_HTTP_UPSTREAM_KEY=replace-with-private-provider-key
HINDSIGHT_API_HTTP_ACTIVITY_URL=http://host.docker.internal:3000/api/internal/memory-admission
