# Daily sweep of the LTX ComfyUI's own files (review I-5,
# docs/plans/video-review-2026-11-17/review.md), as comfyui-clean.service does
# for Qwen and comfyui-h3-clean.service for H3. Every video take leaves its mp4
# (blocked and incognito clips included, with the prompt in its tags) in
# output/ and its guide stills in input/; nothing else removes them. A day is
# far past VIDEO_RENDER_DEADLINE_MS (15 minutes), the longest a resumed take
# still fetches its finished segments from output/
# (tests/integration/comfyui-ltx-sweep.test.ts holds the two together).
# Install: deploy/comfyui/README.md.
[Unit]
Description=Delete ComfyUI LTX inputs, outputs and temp files older than a day (review I-5)

[Service]
Type=oneshot
User=alfyws
Group=alfyws
ExecStart=/usr/bin/find /home/alfyws/opt/comfyui-ltx/input /home/alfyws/opt/comfyui-ltx/output /home/alfyws/opt/comfyui-ltx/temp -type f -mmin +1440 -delete
