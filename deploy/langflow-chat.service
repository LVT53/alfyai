[Unit]
Description=AlfyAI Application
After=network.target

[Service]
Type=simple
User=alfydesign
Group=alfydesign
WorkingDirectory=/home/alfydesign/apps/langflow-chat/current
EnvironmentFile=/home/alfydesign/apps/langflow-chat/current/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/alfydesign/apps/langflow-chat/current/build/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
