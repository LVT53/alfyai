[Unit]
Description=vLLM v0.31.0 Qwen3.8-Flash-Next Uncensored (jpezzulli NVFP4, FP8 PLE) with FP8 KV on GPU0 (venv)
After=network-online.target
Wants=network-online.target
Conflicts=vllm-qwen27b-heretic.service

[Service]
EnvironmentFile=/etc/vllm/flashnext.env
Type=simple
User=alfyws
Group=alfyws
WorkingDirectory=/home/alfyws
Environment=PATH=/home/alfyws/venvs/vllm-0.31/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CUDA_HOME=/usr/local/cuda
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=0
Environment=HF_HUB_OFFLINE=1
Environment=VLLM_NO_USAGE_STATS=1
Environment=DO_NOT_TRACK=1
Environment=VLLM_CACHE_ROOT=/home/alfyws/.cache/vllm-0.31
Environment=TORCHINDUCTOR_CACHE_DIR=/home/alfyws/.cache/vllm-0.31/torchinductor
Environment=TRITON_CACHE_DIR=/home/alfyws/.cache/vllm-0.31/triton
Environment=VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=512
Environment=VLLM_USE_V2_MODEL_RUNNER=1
Environment=VLLM_WORKER_MULTIPROC_METHOD=spawn
Environment=TOKENIZERS_PARALLELISM=false
LimitMEMLOCK=infinity
LimitNOFILE=1048576
ExecStart=/home/alfyws/venvs/vllm-0.31/bin/vllm serve /home/alfyws/hf_models/flashnext/v031/jpezzulli-orcarouter-uncensored-nvfp4 \
  --served-model-name qwen3-6-27b qwen3-8-flash-next flash-next \
  --host 0.0.0.0 --port 30000 \
  --trust-remote-code \
  --gpu-memory-utilization 0.92 \
  --max-model-len 262144 \
  --max-num-seqs 16 \
  --max-num-batched-tokens 8192 \
  --kv-cache-dtype fp8 \
  --attention-config '{"indexer_kv_dtype":"fp8"}' \
  --engram-config '{"cpu_offload": true}' \
  --mamba-cache-mode align \
  --enable-chunked-prefill \
  --enable-prefix-caching \
  --enable-auto-tool-choice \
  --tool-call-parser qwen3_coder \
  --reasoning-parser qwen3 \
  --speculative-config '{"method":"mtp","num_speculative_tokens":3,"model":"/home/alfyws/hf_models/flashnext/v031/mtp-drafter-nvfp4"}'
Restart=always
RestartSec=15
TimeoutStartSec=1800
TimeoutStopSec=120
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
