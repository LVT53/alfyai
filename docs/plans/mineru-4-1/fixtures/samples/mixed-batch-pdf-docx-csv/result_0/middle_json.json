          ],
          "content": [
            {
              "type": "text",
              "content": "1. Introduction"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.09,
            0.265,
            0.91,
            0.324
          ],
          "content": [
            {
              "type": "text",
              "content": "Let "
            },
            {
              "type": "equation_inline",
              "content": "x_{i}\\in\\mathbb{R}^{d}"
            },
            {
              "type": "text",
              "content": " denote the feature vector of page i, and let "
            },
            {
              "type": "equation_inline",
              "content": "\\alpha \\in (0,1)"
            },
            {
              "type": "text",
              "content": " be a mixing weight. The empirical loss is "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal{L}(\\theta) = \\frac{1}{N}\\sum_{i = 1}^{N}\\ell (f_{\\theta}(x_{i}),y_{i})"
            },
            {
              "type": "text",
              "content": " and the regulariser satisfies "
            },
            {
              "type": "equation_inline",
              "content": "\\| \\theta \\| _2\\leq 1.^1"
            },
            {
              "type": "text",
              "content": " The latency model that we fit is given by"
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.275,
            0.334,
            0.906,
            0.376
          ],
          "image_path": "images/page_0_equation_6.jpg",
          "content": "T (n) = a + b n + c n ^ {2}, \\quad \\int_ {0} ^ {\\infty} e ^ {- x ^ {2}} d x = \\frac {\\sqrt {\\pi}}{2}\\tag{1}"
        },
        {
          "type": "page_number",
          "index": 7,
          "bbox": [
            0.495,
            0.912,
            0.506,
            0.924
          ],
          "content": [
